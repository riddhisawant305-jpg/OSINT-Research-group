# CareerVerse Backend Environment Configuration Example
PORT=5000
CLIENT_URL=http://localhost:5173
JWT_SECRET=your_jwt_secret_key_here

# MongoDB Connection String (Atlas URI or local mongodb://127.0.0.1:27017/careerverse)
MONGO_URI=mongodb://127.0.0.1:27017/careerverse

# Gemini AI Integration
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Google OAuth Credentials
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here

# SMTP Email Dispatch
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USERNAME=your_email@gmail.com
SMTP_PASSWORD=your_email_app_password_here
MAIL_FROM="CareerVerse" <your_email@gmail.com>
